---
// The Stem Splitter docs moved to /docs/stem-splitter/; old links land here.
import MovedPage from '../../components/MovedPage.astro';
import { getToolGuidePaths } from '../../lib/tool-docs';

export function getStaticPaths() {
  return getToolGuidePaths('stem-splitter').map(({ params }) => ({ params }));
}

const { page } = Astro.params;
---

<MovedPage to={`/docs/stem-splitter/${page ? `${page}/` : ''}`} />
