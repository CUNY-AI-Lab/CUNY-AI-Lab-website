---
// The Systems Mapping docs moved to /docs/systems-mapping/; old links land here.
import MovedPage from '../../components/MovedPage.astro';
import { getToolGuidePaths } from '../../lib/tool-docs';

export function getStaticPaths() {
  return getToolGuidePaths('systems-mapping').map(({ params }) => ({ params }));
}

const { page } = Astro.params;
---

<MovedPage to={`/docs/systems-mapping/${page ? `${page}/` : ''}`} />
