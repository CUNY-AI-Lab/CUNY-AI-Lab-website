---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const base = import.meta.env.BASE_URL;
const jsonPath = path.join(process.cwd(), 'src/data/faq.json');
const data = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
const withBase = (html: string) => html.replaceAll('href="/', `href="${base}`);
---

<BaseLayout title="FAQ - CUNY AI Lab" description="Frequently asked questions about CUNY AI Lab access, sign-in, cost, models, data handling, and support.">
  <PageHero>
    <h1 class="text-4xl md:text-5xl font-bold font-display text-white tracking-tight">{data.title}</h1>
    <p class="mt-4 max-w-3xl text-lg text-white/85 leading-relaxed faq-intro" set:html={withBase(data.intro)} />
  </PageHero>

  <section class="py-12 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="FAQ sections" class="flex flex-wrap gap-2 mb-12">
        {data.sections.map((section: any) => (
          <a href={`#${section.id}`} class="inline-flex items-center rounded-full border border-gray-200 bg-neutral-cream px-4 py-1.5 text-sm font-semibold text-neutral-stone hover:border-vibrant-400 hover:text-vibrant-700 transition-colors">{section.heading}</a>
        ))}
      </nav>

      {data.sections.map((section: any) => (
        <div id={section.id} class="mb-14 scroll-mt-28">
          <h2 class="text-2xl font-bold font-display text-neutral-stone mb-6">{section.heading}</h2>
          <div class="divide-y divide-gray-200 border-y border-gray-200">
            {section.items.map((item: any) => (
              <details id={item.id} class="faq-item group scroll-mt-28">
                <summary class="flex items-start justify-between gap-4 py-5 cursor-pointer list-none text-left font-semibold text-neutral-stone hover:text-vibrant-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-vibrant-400 rounded">
                  <span>{item.q}</span>
                  <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-gray-400 transition-transform group-open:rotate-180" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </summary>
                <div class="faq-answer pb-6 pr-9 text-gray-600 leading-relaxed" set:html={withBase(item.a)} />
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Open the question named in the URL hash so deep links land on an expanded answer.
  (function () {
    function openFromHash() {
      var id = window.location.hash.replace('#', '');
      if (!id) return;
      var el = document.getElementById(id);
      if (el && el.tagName === 'DETAILS') el.open = true;
    }
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  })();
</script>

<style is:global>
  .faq-intro a { color: #ffffff; text-decoration: underline; text-underline-offset: 3px; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-answer { font-family: 'Inter', system-ui, sans-serif; }
  .faq-answer p { margin-bottom: 0.75rem; }
  .faq-answer p:last-child { margin-bottom: 0; }
  .faq-answer ul, .faq-answer ol { margin: 0.5rem 0 0.75rem 1.5rem; }
  .faq-answer ul { list-style: disc; }
  .faq-answer ol { list-style: decimal; }
  .faq-answer li { margin-bottom: 0.4rem; }
  .faq-answer li:last-child { margin-bottom: 0; }
  .faq-answer a { color: #3268D8; text-decoration: underline; text-underline-offset: 2px; }
  .faq-answer a:hover { color: #2A6FB8; }
  .faq-answer strong { color: #333333; }
  .faq-answer code { font-size: 0.9em; background: #f3f4f6; padding: 0.1em 0.35em; border-radius: 0.25rem; }
</style>
