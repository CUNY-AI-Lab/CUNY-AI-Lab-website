---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Model Registry - CUNY AI Lab">
  <section class="relative pt-24 pb-10 lg:pt-28 bg-cuny-blue text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold tracking-widest uppercase mb-3">CUNY AI Lab · Model API</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold">Model Registry</h1>
      <p class="mt-4 max-w-2xl text-lg text-blue-100">Browse models by name, with each model’s providers underneath. Compare context limits and token prices, then copy an exact API ID.</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 mt-6 text-sm font-semibold">
        <a class="underline underline-offset-4" href={`${base}models/guide/`}>Read the registry guide</a>
        <a class="underline underline-offset-4" href={`${base}docs/api-keys/`}>Model API documentation</a>
      </div>
    </div>
  </section>
  <section class="bg-neutral-cream py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" id="model-registry">
      <div class="registry-filters">
        <div class="filter-field"><label for="model-search">Search models</label><input id="model-search" type="search" placeholder="Name, API ID, provider, or capability" autocomplete="off" /></div>
        <div class="filter-field"><label for="provider-filter">Provider</label><select id="provider-filter"><option value="">All providers</option></select></div>
        <div class="filter-field"><label for="capability-filter">Capability</label><select id="capability-filter"><option value="">All capabilities</option></select></div>
        <button id="clear-filters" type="button">Clear filters</button>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3 py-5">
        <p id="catalog-status" role="status" aria-label="Catalog status" class="text-sm text-gray-600">Loading the live catalog…</p>
        <button id="refresh-catalog" class="registry-button" type="button">Refresh catalog</button>
      </div>
      <p class="text-sm text-gray-600 mb-4">Models are sorted by name, with provider offerings shown underneath. Filters show the providers that match your selection. Listed availability can change and does not guarantee a successful request. Prices are USD per million input/output tokens. “From” rates are separate minima and may come from different endpoints; the selected route and additional fees can cost more.</p>
      <p class="text-sm text-gray-600 mb-4">Reference facts link to their published sources and carry their own check dates. Advertised sizes and checkpoint parameter counts are labeled separately.</p>
      <p id="results-count" class="font-semibold mb-3" aria-live="polite"></p>
      <div id="models-list"></div>
      <p id="empty-state" class="py-12 text-center text-gray-600" hidden></p>
      <noscript><p class="py-6">JavaScript is needed to load and filter the live registry. <a class="underline text-vibrant-600" href="https://tools.ailab.gc.cuny.edu/v1/catalog">Open the public Gateway catalog</a> or <a class="underline text-vibrant-600" href={`${base}models/guide/`}>read the registry guide</a>.</p></noscript>
    </div>
  </section>
</BaseLayout>
<script>
  import '../scripts/model-availability';
</script>
<style is:global>
  #model-registry .registry-filters { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr) auto; gap: 1rem; align-items: end; }
  #model-registry .filter-field { display: grid; gap: .4rem; }
  #model-registry label { font-size: .875rem; font-weight: 600; }
  #model-registry input, #model-registry select { width: 100%; min-width: 0; padding: .7rem; border: 1px solid #9ca3af; border-radius: .5rem; background: white; font-weight: 400; }
  #model-registry button { border: 1px solid #3268D8; border-radius: .5rem; padding: .65rem .8rem; color: #1D3A83; background: white; font-size: .875rem; font-weight: 600; }
  #model-registry button:hover { background: #eff6ff; }
  #model-registry button:disabled { opacity: .6; cursor: wait; }
  #model-registry :is(button, input, select):focus-visible { outline: 3px solid #3268D8; outline-offset: 3px; }
  #model-registry .model-card { padding: 1.4rem 1.5rem; border: 1px solid #dbe1e9; border-radius: .65rem; background: white; margin-bottom: 1rem; }
  #model-registry .provider-offering { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, .9fr) minmax(0, 1fr); column-gap: 1.5rem; row-gap: .65rem; padding-top: 1rem; margin-top: 1rem; border-top: 1px solid #e2e7ee; }
  #model-registry .model-card[hidden], #model-registry .provider-offering[hidden] { display: none; }
  #model-registry .model-card h2 { font-family: Outfit, sans-serif; font-size: 1.5rem; line-height: 1.25; font-weight: 600; overflow-wrap: anywhere; color: #1D3A83; }
  #model-registry .provider { font-size: .85rem; font-weight: 650; color: #333333; margin-bottom: .4rem; }
  #model-registry .identity { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; }
  #model-registry code { font-size: .75rem; overflow-wrap: anywhere; background: #f4f6f9; padding: .3rem .4rem; border-radius: .2rem; user-select: all; }
  #model-registry .identity button { padding: .25rem .45rem; font-size: .7rem; border-color: #c5d2e7; border-radius: .25rem; }
  #model-registry .spec-label { font-size: .7rem; font-weight: 500; color: #596579; margin-bottom: .35rem; }
  #model-registry .spec-value { font-size: .82rem; font-variant-numeric: tabular-nums; line-height: 1.6; }
  #model-registry .capabilities { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: .4rem 1rem; }
  #model-registry .capability { display: inline-flex; align-items: center; gap: .3rem; font-size: .7rem; color: #4b5b72; overflow-wrap: anywhere; }
  #model-registry .capability svg { width: .9rem; height: .9rem; flex-shrink: 0; color: #3268D8; }
  #model-registry .model-summary { margin-top: .65rem; }
  #model-registry .model-highlights { display: flex; align-items: baseline; flex-wrap: wrap; gap: .5rem 0; }
  #model-registry .model-highlight { min-width: 0; max-width: 100%; padding-right: 1rem; margin-right: 1rem; border-right: 1px solid #dbe1e9; font-size: .8rem; color: #36465e; overflow-wrap: anywhere; }
  #model-registry .model-highlight:last-child { border-right: 0; padding-right: 0; margin-right: 0; }
  #model-registry .model-highlight a { color: #1D3A83; text-decoration: none; }
  #model-registry .model-highlight a:hover { text-decoration: underline; text-underline-offset: 3px; }
  #model-registry .model-size { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: .35rem; }
  #model-registry .model-size strong { font-size: 1.05rem; font-weight: 600; color: #333333; }
  #model-registry .size-basis { font-size: .72rem; color: #596579; }
  #model-registry .model-reference-footer { display: flex; flex-wrap: wrap; gap: .4rem 1rem; margin-top: .65rem; align-items: baseline; }
  #model-registry .model-details { min-width: 0; }
  #model-registry .model-details[open] { flex-basis: 100%; }
  #model-registry .model-details summary { cursor: pointer; color: #36527b; font-size: .72rem; width: fit-content; }
  #model-registry .model-details summary:focus-visible { outline: 3px solid #3268D8; outline-offset: 4px; }
  #model-registry .model-evidence { margin-top: .7rem; padding: .7rem 1rem; border-left: 2px solid #c5d2e7; background: #f6f8fb; }
  #model-registry .model-references { display: grid; grid-template-columns: 6rem minmax(0, 1fr) auto; gap: .4rem 1rem; align-items: baseline; padding: .35rem 0; font-size: .73rem; }
  #model-registry .evidence-label { color: #596579; }
  #model-registry .model-references a { min-width: 0; overflow-wrap: anywhere; color: #1D3A83; text-decoration: underline; text-underline-offset: 3px; }
  #model-registry .specification-date, #model-registry .summary-date { color: #596579; font-size: .7rem; }
  #model-registry .model-details[open] + .summary-date { display: none; }
  #model-registry .copy-result { font-size: .75rem; }
  @media (max-width: 767px) {
    #model-registry .model-card { padding: 1.1rem; }
    #model-registry .model-card h2 { font-size: 1.3rem; }
    #model-registry .model-highlights { gap: .35rem 1rem; }
    #model-registry .model-highlight { border: 0; margin: 0; padding: 0; }
    #model-registry .model-size { flex-basis: 100%; }
    #model-registry .model-references { grid-template-columns: minmax(0, 1fr); gap: .2rem; padding: .5rem 0; }
    #model-registry .registry-filters { grid-template-columns: 1fr 1fr; }
    #model-registry .registry-filters .filter-field:first-child { grid-column: 1 / -1; }
    #model-registry .provider-offering { grid-template-columns: 1fr 1fr; gap: 1rem; }
    #model-registry .offering-identity { grid-column: 1 / -1; }
  }
  @media (max-width: 380px) { #model-registry .registry-filters, #model-registry .provider-offering { grid-template-columns: 1fr; } }
</style>
