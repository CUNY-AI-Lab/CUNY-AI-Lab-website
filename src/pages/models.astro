---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Model Registry - CUNY AI Lab">
  <section class="relative pt-24 pb-10 lg:pt-28 bg-cuny-blue text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold tracking-widest uppercase mb-3">CUNY AI Lab · Model API</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold">Model Registry</h1>
      <p class="mt-4 max-w-2xl text-lg text-blue-100">Browse the full live Gateway catalog. Compare provider offerings, context limits, and token prices, then copy an exact API ID.</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 mt-6 text-sm font-semibold">
        <a class="underline underline-offset-4" href={`${base}models/guide/`}>Read the registry guide</a>
        <a class="underline underline-offset-4" href={`${base}docs/api-keys/`}>Model API documentation</a>
      </div>
    </div>
  </section>
  <section class="bg-neutral-cream py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" id="model-registry">
      <div class="registry-filters">
        <div class="filter-field"><label for="model-search">Search models</label><input id="model-search" type="search" placeholder="Name, API ID, provider, or capability" autocomplete="off" /></div>
        <div class="filter-field"><label for="provider-filter">Provider</label><select id="provider-filter"><option value="">All providers</option></select></div>
        <div class="filter-field"><label for="capability-filter">Capability</label><select id="capability-filter"><option value="">All capabilities</option></select></div>
        <button id="clear-filters" type="button">Clear filters</button>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3 py-5">
        <p id="catalog-status" role="status" aria-label="Catalog status" class="text-sm text-gray-600">Loading the live catalog…</p>
        <button id="refresh-catalog" class="registry-button" type="button">Refresh catalog</button>
      </div>
      <p class="text-sm text-gray-600 mb-4">Each row is one provider offering, sorted by name. Listed availability can change and does not guarantee a successful request. Prices are USD per million input/output tokens. “From” rates are separate minima and may come from different endpoints; the selected route and additional fees can cost more.</p>
      <p id="results-count" class="font-semibold mb-3" aria-live="polite"></p>
      <div id="models-list"></div>
      <p id="empty-state" class="py-12 text-center text-gray-600" hidden></p>
      <noscript><p class="py-6">JavaScript is needed to load and filter the live registry. <a class="underline text-vibrant-600" href="https://tools.ailab.gc.cuny.edu/v1/catalog">Open the public Gateway catalog</a> or <a class="underline text-vibrant-600" href={`${base}models/guide/`}>read the registry guide</a>.</p></noscript>
    </div>
  </section>
</BaseLayout>
<script>
  import '../scripts/model-availability';
</script>
<style is:global>
  #model-registry .registry-filters { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr) auto; gap: 1rem; align-items: end; }
  #model-registry .filter-field { display: grid; gap: .4rem; }
  #model-registry label { font-size: .875rem; font-weight: 600; }
  #model-registry input, #model-registry select { width: 100%; min-width: 0; padding: .7rem; border: 1px solid #9ca3af; border-radius: .5rem; background: white; font-weight: 400; }
  #model-registry button { border: 1px solid #3268D8; border-radius: .5rem; padding: .65rem .8rem; color: #1D3A83; background: white; font-size: .875rem; font-weight: 600; }
  #model-registry button:hover { background: #eff6ff; }
  #model-registry button:disabled { opacity: .6; cursor: wait; }
  #model-registry :is(button, input, select):focus-visible { outline: 3px solid #3268D8; outline-offset: 3px; }
  #model-registry .model-card { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr) minmax(0, 1fr); gap: 1.25rem; padding: 1.25rem; border: 1px solid #d1d5db; border-radius: .7rem; background: white; margin-bottom: .75rem; }
  #model-registry .model-card[hidden] { display: none; }
  #model-registry .model-card h2 { font-family: Outfit, sans-serif; font-size: 1.125rem; font-weight: 600; overflow-wrap: anywhere; color: #1D3A83; }
  #model-registry .provider { font-size: .8rem; font-weight: 600; color: #4b5563; margin-bottom: .3rem; }
  #model-registry .identity { margin-top: .65rem; display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; }
  #model-registry code { font-size: .75rem; overflow-wrap: anywhere; background: #f3f4f6; padding: .25rem .4rem; border-radius: .25rem; user-select: all; }
  #model-registry .identity button { padding: .3rem .5rem; font-size: .75rem; }
  #model-registry .spec-label { font-size: .75rem; font-weight: 600; color: #4b5563; margin-bottom: .3rem; }
  #model-registry .spec-value { font-size: .875rem; }
  #model-registry .capabilities { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .7rem; }
  #model-registry .capability { font-size: .75rem; border-radius: .25rem; background: #eff6ff; color: #1D3A83; padding: .2rem .4rem; overflow-wrap: anywhere; }
  #model-registry .copy-result { font-size: .75rem; }
  @media (max-width: 767px) {
    #model-registry .registry-filters { grid-template-columns: 1fr 1fr; }
    #model-registry .registry-filters .filter-field:first-child { grid-column: 1 / -1; }
    #model-registry .model-card { grid-template-columns: 1fr 1fr; gap: 1rem; }
    #model-registry .offering-identity { grid-column: 1 / -1; }
  }
  @media (max-width: 380px) { #model-registry .registry-filters, #model-registry .model-card { grid-template-columns: 1fr; } }
</style>
