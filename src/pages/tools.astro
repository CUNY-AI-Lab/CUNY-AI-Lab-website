---
import BaseLayout from '../layouts/BaseLayout.astro';
import tools from '../data/tools.json';

const base = import.meta.env.BASE_URL;
const tones = {
  blue: {
    icon: 'bg-blue-100 text-blue-700',
    border: 'hover:border-blue-200',
  },
  pink: {
    icon: 'bg-pink-100 text-pink-700',
    border: 'hover:border-pink-200',
  },
  indigo: {
    icon: 'bg-indigo-100 text-indigo-700',
    border: 'hover:border-indigo-200',
  },
};
---

<BaseLayout title="Tools - CUNY AI Lab">
  <section class="relative pt-24 pb-12 lg:pt-28 lg:pb-14">
    <div class="absolute inset-0 bg-gradient-to-b from-cuny-blue via-cuny-blue to-vibrant-900"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%23ffffff&quot; fill-opacity=&quot;1&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <p class="text-vibrant-100 font-semibold tracking-wide uppercase text-sm mb-3">CUNY AI Lab</p>
      <h1 class="text-4xl md:text-5xl font-bold font-display text-white tracking-tight">{tools.title}</h1>
      <p class="mt-5 max-w-3xl text-lg text-blue-100 leading-relaxed">{tools.intro}</p>
    </div>
  </section>

  <div class="bg-neutral-cream">
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16" aria-labelledby="sandbox-heading">
      <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
        <div class="grid lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] items-stretch">
          <div class="p-8 lg:p-12 flex flex-col justify-center">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-vibrant-800 mb-3">AI chat</p>
            <h2 id="sandbox-heading" class="text-3xl font-bold font-display text-neutral-stone">{tools.sandbox.title}</h2>
            <p class="mt-5 text-gray-600 leading-relaxed">{tools.sandbox.description}</p>
            <div class="mt-7">
              <a href={tools.sandbox.url} class="inline-flex items-center gap-2 px-6 py-3 bg-vibrant-700 text-white rounded-full font-semibold hover:bg-vibrant-800 transition-colors shadow-md">
                {tools.sandbox.action}
                <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            </div>
          </div>
          <div class="bg-gradient-to-br from-vibrant-50 to-blue-50 p-5 sm:p-8 flex items-center">
            <img src={`${base}${tools.sandbox.image}`} alt={tools.sandbox.image_alt} class="w-full h-auto rounded-xl border border-gray-200 shadow-lg" />
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 lg:pb-16" aria-labelledby="tools-heading">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-indigo-700 mb-2">Tools portal</p>
          <h2 id="tools-heading" class="text-3xl font-bold font-display text-neutral-stone">Media, research, publishing, and model access</h2>
        </div>
        <p class="text-sm text-gray-500 max-w-md">Media tools open directly. The studios and Model Access require CUNY sign-in.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {tools.tools.map((tool) => {
          const tone = tones[tool.tone as keyof typeof tones];
          return (
            <a href={tool.url} class={`group bg-white rounded-2xl border border-gray-200 ${tone.border} p-7 hover:shadow-lg transition-all focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-vibrant-600`}>
              <div class={`w-11 h-11 rounded-xl ${tone.icon} flex items-center justify-center mb-5`}>
                <svg class="w-5 h-5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m5-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-xl font-bold font-display text-neutral-stone">{tool.title}</h3>
              <p class="mt-3 text-sm text-gray-600 leading-relaxed">{tool.description}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-vibrant-700 group-hover:text-vibrant-800">
                {tool.action}
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="border-t border-vibrant-100 bg-vibrant-50/70" aria-labelledby="access-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-12 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-7">
        <div class="max-w-2xl">
          <h2 id="access-heading" class="text-2xl font-bold font-display text-neutral-stone">{tools.access.title}</h2>
          <p class="mt-2 text-gray-600 leading-relaxed">{tools.access.description}</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
          <a href={tools.access.url} class="inline-flex justify-center items-center px-6 py-3 bg-vibrant-700 text-white rounded-full font-semibold hover:bg-vibrant-800 transition-colors shadow-md">{tools.access.action}</a>
          <a href={tools.access.admin_url} class="inline-flex justify-center items-center px-5 py-3 text-sm font-semibold text-vibrant-700 hover:text-vibrant-900 underline underline-offset-4">{tools.access.admin_action}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
