---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const mobileTabBase = 'mobile-tab flex-shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium transition-all border-2';
const desktopCardBase = 'sidebar-card group w-full text-left rounded-xl p-5 transition-all duration-300';
const toolCategories = [
  {
    id: 'sandbox',
    label: 'CAIL Sandbox',
    iconPath: 'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z',
    description: 'Chat platform for teaching and research with open-weight models',
    tags: ['Chat', 'Models', 'Open WebUI'],
    tagClass: 'bg-vibrant-50 text-vibrant-700',
    iconBackgroundClass: 'bg-vibrant-100',
    iconColorClass: 'text-vibrant-600',
    mobile: {
      activeClass: 'border-vibrant-500 bg-vibrant-50 text-vibrant-700',
      inactiveClass: 'border-transparent bg-white text-gray-600 hover:border-gray-200',
    },
    desktop: {
      activeClass: 'bg-white border-l-4 border-vibrant-500 shadow-md',
      inactiveClass: 'bg-white/60 border-l-4 border-transparent hover:bg-white hover:shadow-sm',
    },
  },
  {
    id: 'media',
    label: 'Media Processing',
    iconPath: 'M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3-3z',
    description: 'Tools for transcription, alt-text, and OCR',
    tags: ['Transcription', 'Alt-text', 'OCR'],
    tagClass: 'bg-teal-50 text-teal-700',
    iconBackgroundClass: 'bg-teal-50',
    iconColorClass: 'text-teal-600',
    mobile: {
      activeClass: 'border-teal-500 bg-teal-50 text-teal-700',
      inactiveClass: 'border-transparent bg-white text-gray-600 hover:border-gray-200',
    },
    desktop: {
      activeClass: 'bg-white border-l-4 border-teal-500 shadow-md',
      inactiveClass: 'bg-white/60 border-l-4 border-transparent hover:bg-white hover:shadow-sm',
    },
  },
  {
    id: 'assistants',
    label: 'AI Assistants',
    iconPath: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
    description: 'Tools for conducting research and building websites',
    tags: ['Agent Studio', 'Site Studio'],
    tagClass: 'bg-indigo-50 text-indigo-700',
    iconBackgroundClass: 'bg-indigo-50',
    iconColorClass: 'text-indigo-600',
    mobile: {
      activeClass: 'border-indigo-500 bg-indigo-50 text-indigo-700',
      inactiveClass: 'border-transparent bg-white text-gray-600 hover:border-gray-200',
    },
    desktop: {
      activeClass: 'bg-white border-l-4 border-indigo-500 shadow-md',
      inactiveClass: 'bg-white/60 border-l-4 border-transparent hover:bg-white hover:shadow-sm',
    },
  },
  {
    id: 'model-access',
    label: 'Model Access',
    iconPath: 'M15 7a2 2 0 1 1 2 2m0 0h4v4h-2v2h-2l-2-2m2-4-7.5 7.5a2.121 2.121 0 01-3-3L14 6',
    description: 'Personal API keys for Model Access',
    tags: ['API keys'],
    tagClass: 'bg-blue-50 text-blue-700',
    iconBackgroundClass: 'bg-blue-50',
    iconColorClass: 'text-blue-600',
    mobile: {
      activeClass: 'border-blue-500 bg-blue-50 text-blue-700',
      inactiveClass: 'border-transparent bg-white text-gray-600 hover:border-gray-200',
    },
    desktop: {
      activeClass: 'bg-white border-l-4 border-blue-500 shadow-md',
      inactiveClass: 'bg-white/60 border-l-4 border-transparent hover:bg-white hover:shadow-sm',
    },
  },
] as const;
---

<BaseLayout title="Tools - CUNY AI Lab">
  <!-- Hero Section -->
  <section class="relative pt-24 pb-10 lg:pt-28 lg:pb-12">
    <div class="absolute inset-0 bg-gradient-to-b from-cuny-blue via-cuny-blue to-vibrant-900"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%23ffffff&quot; fill-opacity=&quot;1&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-4xl md:text-5xl font-bold font-display text-white tracking-tight">Tools</h1>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!-- Sidebar + Content Panel                     -->
  <!-- ═══════════════════════════════════════════ -->

  <section class="bg-neutral-cream min-h-[60vh]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <!-- Mobile: Horizontal selector (visible < lg) -->
      <div class="mobile-tablist flex gap-2 mb-8 lg:hidden overflow-x-auto -mx-1 px-1" role="tablist" aria-label="Tool categories">
        {toolCategories.map((category) => {
          const selected = category.id === 'sandbox';
          const activeClass = `${mobileTabBase} ${category.mobile.activeClass}`;
          const inactiveClass = `${mobileTabBase} ${category.mobile.inactiveClass}`;
          return (
            <button type="button" class={selected ? activeClass : inactiveClass} data-active-class={activeClass} data-inactive-class={inactiveClass} data-panel={category.id} role="tab" aria-selected={selected ? 'true' : 'false'} aria-controls={`panel-${category.id}`} tabindex={selected ? '0' : '-1'}>
              <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={category.iconPath} /></svg>
              {category.label}
            </button>
          );
        })}
      </div>

      <div class="tools-layout">

        <!-- ── Sidebar (desktop: sticky, visible >= lg) ── -->
        <aside class="tools-sidebar hidden lg:block">
          <div class="sticky top-24 space-y-3" role="tablist" aria-label="Tool categories" aria-orientation="vertical">
            {toolCategories.map((category) => {
              const selected = category.id === 'sandbox';
              const activeClass = `${desktopCardBase} ${category.desktop.activeClass}`;
              const inactiveClass = `${desktopCardBase} ${category.desktop.inactiveClass}`;
              return (
                <button type="button" class={selected ? activeClass : inactiveClass} data-active-class={activeClass} data-inactive-class={inactiveClass} data-panel={category.id} role="tab" aria-selected={selected ? 'true' : 'false'} aria-controls={`panel-${category.id}`} tabindex={selected ? '0' : '-1'}>
                  <div class="flex items-center gap-3 mb-2">
                    <div class={`w-9 h-9 rounded-lg ${category.iconBackgroundClass} flex items-center justify-center flex-shrink-0`}>
                      <svg class={`w-4.5 h-4.5 ${category.iconColorClass}`} aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d={category.iconPath} />
                      </svg>
                    </div>
                    <h2 class="text-base font-bold font-display text-neutral-stone">{category.label}</h2>
                  </div>
                  <p class="text-gray-500 text-xs leading-relaxed mb-3 pl-12">{category.description}</p>
                  <div class="flex flex-wrap gap-1 pl-12">
                    {category.tags.map((tag) => (
                      <span class={`px-2 py-0.5 ${category.tagClass} text-[10px] font-medium rounded-full`}>{tag}</span>
                    ))}
                  </div>
                </button>
              );
            })}

          </div>
        </aside>

        <!-- ── Content Panel ── -->
        <div class="min-w-0">

          <!-- ╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌ -->
          <!-- Panel: CAIL Sandbox               -->
          <!-- ╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌ -->
          <div id="panel-sandbox" class="content-panel" role="tabpanel" aria-label="CAIL Sandbox">
            <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">

              <!-- Main content -->
              <div class="p-8 lg:p-10">
                <h2 class="text-3xl font-bold font-display text-neutral-stone mb-6">CAIL Sandbox</h2>
                <div class="space-y-4 text-gray-600 leading-relaxed max-w-3xl">
                  <p>
                    The <a href="https://chat.ailab.gc.cuny.edu/" target="_blank" rel="noopener noreferrer" class="text-vibrant-600 hover:text-vibrant-700 underline font-semibold">CAIL Sandbox</a> provides CUNY students, faculty, and staff with an AI chat interface and a curated set of open-weight models. While conversations are privately stored in your Sandbox account, all requests to model providers are configured for zero retention. Users can configure models to their needs while also gaining insight into the environmental impacts of their tool use.
                  </p>
                  <p>
                    Existing approved users can sign in with CUNY Login. If you need access or cannot sign in, <a href={`${base}request-access`} class="text-vibrant-600 hover:text-vibrant-700 underline font-semibold">request access or support</a>.
                  </p>
                  <p>
                    For current model availability, check the Sandbox model selector. Our <a href={`${base}models`} class="text-vibrant-600 hover:text-vibrant-700 underline font-semibold">Model Registry</a> provides Lab-reviewed reference notes for a smaller set of models.
                  </p>
                </div>

                <div class="mt-8 flex flex-wrap gap-4">
                  <a href="https://chat.ailab.gc.cuny.edu/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-vibrant-600 text-white rounded-full font-medium hover:bg-vibrant-700 transition-colors shadow-md">
                    Launch CAIL Sandbox
                    <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                  </a>
                  <a href={`${base}models`} class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 text-neutral-stone rounded-full font-medium hover:border-vibrant-300 hover:text-vibrant-600 transition-colors">
                    View Model Registry
                  </a>
                </div>

                <div class="mt-10 max-w-4xl mx-auto rounded-xl overflow-hidden shadow-lg border border-gray-200">
                  <img src={`${base}images/tools/tool-owu.png`} alt="CAIL Sandbox interface showing CUNY AI Lab chat platform" class="w-full h-auto" />
                </div>

                <div class="mt-10 grid sm:grid-cols-2 gap-x-10 gap-y-4">
                      <div class="flex items-start gap-3">
                        <div class="w-1.5 h-1.5 rounded-full bg-vibrant-600 mt-2 flex-shrink-0"></div>
                        <div>
                          <span class="font-semibold text-neutral-stone text-sm">Open-weight models</span>
                          <span class="text-gray-500 text-sm ml-1">— Publicly available weights for transparency and auditability</span>
                        </div>
                      </div>
                      <div class="flex items-start gap-3">
                        <div class="w-1.5 h-1.5 rounded-full bg-vibrant-600 mt-2 flex-shrink-0"></div>
                        <div>
                          <span class="font-semibold text-neutral-stone text-sm">Open-source platform</span>
                          <span class="text-gray-500 text-sm ml-1">— Built on Open WebUI, a community-driven chat interface for running AI models</span>
                        </div>
                      </div>
                      <div class="flex items-start gap-3">
                        <div class="w-1.5 h-1.5 rounded-full bg-vibrant-600 mt-2 flex-shrink-0"></div>
                        <div>
                          <span class="font-semibold text-neutral-stone text-sm">Model-provider calls</span>
                          <span class="text-gray-500 text-sm ml-1">— Configured for zero retention</span>
                        </div>
                      </div>
                      <div class="flex items-start gap-3">
                        <div class="w-1.5 h-1.5 rounded-full bg-vibrant-600 mt-2 flex-shrink-0"></div>
                        <div>
                          <span class="font-semibold text-neutral-stone text-sm">Citable configs</span>
                          <span class="text-gray-500 text-sm ml-1">— Shareable, reproducible configurations for scholarly use</span>
                        </div>
                      </div>
                      <div class="flex items-start gap-3">
                        <div class="w-1.5 h-1.5 rounded-full bg-vibrant-600 mt-2 flex-shrink-0"></div>
                        <div>
                          <span class="font-semibold text-neutral-stone text-sm">CO₂ estimates</span>
                          <span class="text-gray-500 text-sm ml-1">— Visible energy and carbon cost per interaction</span>
                        </div>
                      </div>
                      <div class="flex items-start gap-3">
                        <div class="w-1.5 h-1.5 rounded-full bg-vibrant-600 mt-2 flex-shrink-0"></div>
                        <div>
                          <span class="font-semibold text-neutral-stone text-sm">Accessibility</span>
                          <span class="text-gray-500 text-sm ml-1">— Speech-to-text is available through Media Processing; more accessibility tools are in development</span>
                        </div>
                      </div>
                </div>
              </div>

              <!-- Classroom Chatbots sub-section -->
              <div class="border-t border-gray-100 bg-gray-50/50 p-8 lg:p-10">
                <h3 class="text-xl font-bold font-display text-neutral-stone mb-2">Classroom Chatbots</h3>
                <p class="text-gray-500 text-sm mb-6">Custom assistants built inside the CAIL Sandbox</p>

                <div class="space-y-4">
                  <div class="bg-white rounded-xl p-5 border border-gray-100 hover:shadow-md transition-all flex items-start gap-4">
                    <div class="w-9 h-9 rounded-lg bg-indigo-100 flex items-center justify-center flex-shrink-0">
                      <svg class="w-4.5 h-4.5 text-indigo-600" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                      </svg>
                    </div>
                    <div>
                      <h4 class="font-bold text-neutral-stone text-sm mb-1">Course-Specific Assistants</h4>
                      <p class="text-gray-600 text-sm leading-relaxed">Built for a single course from its syllabus, readings, and materials. Guiding questions carry students through difficult texts.</p>
                      <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
                        <span class="text-xs text-gray-500">Examples:</span>
                        <span class="px-2 py-0.5 bg-indigo-50 text-indigo-700 text-[11px] font-medium rounded-full">Writing Process Assistant</span>
                        <span class="px-2 py-0.5 bg-indigo-50 text-indigo-700 text-[11px] font-medium rounded-full">Paratext Analysis Tool</span>
                        <span class="px-2 py-0.5 bg-indigo-50 text-indigo-700 text-[11px] font-medium rounded-full">Active Reading Companion</span>
                      </div>
                    </div>
                  </div>

                  <div class="bg-white rounded-xl p-5 border border-gray-100 hover:shadow-md transition-all flex items-start gap-4">
                    <div class="w-9 h-9 rounded-lg bg-vibrant-100 flex items-center justify-center flex-shrink-0">
                      <svg class="w-4.5 h-4.5 text-vibrant-600" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                      </svg>
                    </div>
                    <div>
                      <h4 class="font-bold text-neutral-stone text-sm mb-1">AmigAI</h4>
                      <p class="text-gray-600 text-sm leading-relaxed">A chatbot that helps CUNY students practice conversational Spanish through culturally responsive pedagogy.</p>
                    </div>
                  </div>

                  <div class="bg-white rounded-xl p-5 border border-gray-100 hover:shadow-md transition-all flex items-start gap-4">
                    <div class="w-9 h-9 rounded-lg bg-green-100 flex items-center justify-center flex-shrink-0">
                      <svg class="w-4.5 h-4.5 text-green-600" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                      </svg>
                    </div>
                    <div>
                      <h4 class="font-bold text-neutral-stone text-sm mb-1">Sandbox Workspace</h4>
                      <p class="text-gray-600 text-sm leading-relaxed">Where custom assistants get made. Prototype custom models, draft system prompts, curate knowledge collections, and learn agentic skills and tools.</p>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- ╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌ -->
          <!-- Panel: Media Processing           -->
          <!-- ╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌ -->
          <div id="panel-media" class="content-panel hidden" role="tabpanel" aria-label="Media Processing">
            <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">

              <!-- Portal header -->
              <div class="p-8 lg:p-10 pb-0 lg:pb-0">
                <h2 class="text-3xl font-bold font-display text-neutral-stone mb-4">CUNY AI Lab Tools Portal</h2>
                <p class="text-gray-600 mb-8 max-w-3xl">Standalone web tools built and hosted by the Lab, separate from the CAIL Sandbox. Review each tool's storage guidance before uploading files.</p>
              </div>

              <!-- Media Processing tools -->
              <div class="px-8 lg:px-10 pb-8 lg:pb-10">
                <h3 class="text-xl font-bold font-display text-neutral-stone mb-2">Media Processing</h3>
                <p class="text-gray-500 text-sm mb-1.5">Powered by Whisper via Fireworks AI, AssemblyAI, and Qwen 3 VL via AWS Bedrock</p>
                <p class="text-xs text-gray-600 mb-6">Need on-premises processing for sensitive data (FERPA, IRB, HIPAA)? <a href={`${base}contact`} class="text-vibrant-600 hover:underline">Contact us</a>.</p>

                <div class="grid md:grid-cols-2 gap-5 mb-8">
                  <a href="https://tools.ailab.gc.cuny.edu/asr/" target="_blank" rel="noopener noreferrer" class="media-tool-btn block bg-neutral-cream rounded-xl p-5 border-2 border-teal-300 transition-all hover:shadow-lg group" data-slide="0">
                    <div class="flex items-start justify-between gap-2">
                      <h4 class="font-bold text-neutral-stone text-sm mb-1">Multilingual Transcription Suite</h4>
                      <svg class="w-4 h-4 text-gray-400 group-hover:text-teal-600 transition-colors flex-shrink-0 mt-0.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    </div>
                    <p class="text-gray-600 text-xs leading-relaxed">Generate transcripts from audio and video in dozens of languages, with optional translation and speaker identification.</p>
                  </a>
                  <a href="https://tools.ailab.gc.cuny.edu/alt-text/" target="_blank" rel="noopener noreferrer" class="media-tool-btn block bg-neutral-cream rounded-xl p-5 border-2 border-transparent transition-all hover:shadow-lg hover:border-gray-200 group" data-slide="1">
                    <div class="flex items-start justify-between gap-2">
                      <h4 class="font-bold text-neutral-stone text-sm mb-1">Image Description</h4>
                      <svg class="w-4 h-4 text-gray-400 group-hover:text-teal-600 transition-colors flex-shrink-0 mt-0.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    </div>
                    <p class="text-gray-600 text-xs leading-relaxed">Create alt-text, captions, and detailed descriptions for images to improve accessibility and support digital publishing workflows.</p>
                  </a>
                  <a href="https://tools.ailab.gc.cuny.edu/ocr/" target="_blank" rel="noopener noreferrer" class="media-tool-btn block bg-neutral-cream rounded-xl p-5 border-2 border-transparent transition-all hover:shadow-lg hover:border-gray-200 group" data-slide="2">
                    <div class="flex items-start justify-between gap-2">
                      <h4 class="font-bold text-neutral-stone text-sm mb-1">Document OCR</h4>
                      <svg class="w-4 h-4 text-gray-400 group-hover:text-teal-600 transition-colors flex-shrink-0 mt-0.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    </div>
                    <p class="text-gray-600 text-xs leading-relaxed">Extract searchable text from PDFs, scanned documents, and archival images — even with difficult layouts or imperfect scans.</p>
                  </a>
                  <a href="https://tools.ailab.gc.cuny.edu/pdf-accessibility/" target="_blank" rel="noopener noreferrer" class="block bg-neutral-cream rounded-xl p-5 border-2 border-transparent transition-all hover:shadow-lg hover:border-gray-200 group">
                    <div class="flex items-start justify-between gap-2">
                      <h4 class="font-bold text-neutral-stone text-sm mb-1">PDF Accessibility</h4>
                      <svg class="w-4 h-4 text-gray-400 group-hover:text-teal-600 transition-colors flex-shrink-0 mt-0.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <p class="text-gray-600 text-xs leading-relaxed">Check and improve PDF files for people who use screen readers and other assistive technology.</p>
                  </a>
                </div>

                <!-- Screenshot Slider -->
                <div class="relative">
