---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FellowCard from '../components/FellowCard.astro';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL;
const jsonPath = path.join(process.cwd(), 'src/data/team.json');
const data = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
---

<BaseLayout title="Team - CUNY AI Lab">
  <!-- Hero Section -->
  <PageHero containerClass="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold font-display text-white tracking-tight">{data.title}</h1>
  </PageHero>

  <!-- Intro -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-lg text-gray-600 leading-relaxed">
        {data.intro}
      </p>
    </div>
  </section>

  <!-- Leadership Section -->
  <section class="py-16 bg-neutral-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold font-display text-neutral-stone mb-8">Leadership</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 justify-items-center">
        {data.leadership.map((member: any) => (
          <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden w-full max-w-[280px] group border border-gray-100">
            <div class="aspect-[3/4] overflow-hidden bg-gray-100 relative">
              <img src={`${base}${member.photo}`} alt={member.name} class={`w-full h-full object-cover object-${member.photo_position} group-hover:scale-105 transition-transform duration-500`} />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
            <div class="p-5">
              <h3 class="text-lg font-bold font-display text-neutral-stone mb-2 leading-tight">{member.name}</h3>
              <p class="text-sm text-gray-600 leading-snug">
                {member.title} <span class="text-gray-400" aria-hidden="true">·</span> {member.subtitle}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Fellows Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold font-display text-neutral-stone mb-8">Fellows, {data.fellows.years}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 justify-items-center">
        {data.fellows.members.map((fellow: any) => <FellowCard {...fellow} />)}
      </div>
    </div>
  </section>

  <!-- Past Fellows Section -->
  <section class="pb-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 border-t border-gray-100">
      <h2 class="text-2xl font-bold font-display text-neutral-stone mb-6">Past Fellows</h2>
      <div class="space-y-3">
        {data.past_fellows.map((cohort: any) => (
          <details class="group/cohort rounded-2xl border border-gray-200 bg-neutral-cream/40 open:bg-white transition-colors">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4 [&::-webkit-details-marker]:hidden">
              <span class="text-lg font-semibold font-display text-neutral-stone">{cohort.years}</span>
              <svg class="h-5 w-5 shrink-0 text-gray-500 transition-transform duration-200 group-open/cohort:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 px-5 pb-5">
              {cohort.members.map((fellow: any) => (
                <li class="flex items-center gap-3">
                  <img src={`${base}${fellow.photo}`} alt="" loading="lazy" class="h-14 w-14 shrink-0 rounded-full object-cover bg-gray-100" />
                  <div class="min-w-0">
                    <p class="font-bold font-display text-neutral-stone leading-tight">{fellow.name}</p>
                    <p class="text-sm text-gray-600 leading-snug">{fellow.program}</p>
                    <p class="text-sm text-gray-500 leading-snug">{fellow.degree}</p>
                  </div>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Collaborating Units -->
  <section class="py-16 bg-neutral-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold font-display text-neutral-stone mb-8">Collaborating Units</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {data.partners.map((partner: any) => (
          <a href={partner.url} target="_blank" rel="noopener noreferrer" class={`flex items-center justify-center ${partner.bg_class || 'bg-white'} p-3 rounded-lg border border-transparent hover:border-vibrant-300 hover:shadow-md transition-all group`}>
            <img src={`${base}${partner.logo}`} alt={partner.name} class="h-20 w-auto object-contain group-hover:scale-105 transition-transform" />
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
