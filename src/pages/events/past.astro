---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL;
const jsonPath = path.join(process.cwd(), 'src/data/events.json');
const data = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
---

<BaseLayout title="Past Events - CUNY AI Lab">
  <!-- Hero Section -->
  <PageHero>
      <h1 class="text-4xl md:text-5xl font-bold font-display text-white tracking-tight">Past Events</h1>
      <p class="mt-4 text-vibrant-200/80 text-lg max-w-2xl">An archive of workshops and events from previous semesters.</p>
  </PageHero>

  <!-- Past Events Archive -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-8">
        {data.past_events.map((group: any) => (
          <div class="relative bg-neutral-cream rounded-2xl border border-gray-200 p-6 md:p-8 overflow-hidden">
            <div class="absolute top-0 left-0 w-1.5 h-full bg-gray-300 rounded-l-2xl"></div>
            <h2 class="text-xl font-bold font-display text-neutral-stone mb-2">{group.title}</h2>
            <p class="text-gray-600 leading-relaxed mb-5">{group.description}</p>
            <ul class="space-y-2.5">
              {group.items.map((item: any) => (
                <li class="flex flex-col sm:flex-row sm:items-baseline gap-x-4 gap-y-0.5">
                  <span class="text-sm font-semibold text-gray-500 sm:w-36 flex-shrink-0">{item.date}</span>
                  <span class="text-gray-700">{item.title}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <a href={`${base}events/`} class="inline-flex items-center gap-1.5 mt-10 text-sm font-semibold text-vibrant-600 hover:text-vibrant-700 transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to current events
      </a>
    </div>
  </section>
</BaseLayout>
