---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const base = import.meta.env.BASE_URL;

const groups = [
  {
    title: 'Applications',
    icon: 'M4 6h16v12H4zM8 10l2 2-2 2m4 0h4',
    links: [
      { title: 'CAIL Sandbox', path: 'docs/sandbox/' },
      { title: 'CAIL Pi', path: 'docs/cail-pi/' },
      { title: 'Stem Splitter', path: 'docs/stem-splitter/' },
      { title: 'Systems Mapping', path: 'docs/systems-mapping/' },
    ],
  },
  {
    title: 'Model Access',
    icon: 'M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.967 8.967 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25',
    links: [
      { title: 'CAIL Model API', path: 'docs/api-keys/' },
      { title: 'Model Registry Guide', path: 'models/guide/' },
    ],
  },
];
---

<BaseLayout title="Documentation - CUNY AI Lab" description="Find guides for CAIL applications, personal API keys, and the model registry.">
  <PageHero>
    <a href={`${base}resources/`} class="inline-block text-sm font-medium text-blue-200 hover:text-white mb-3">Back to Resources</a>
    <h1 class="text-4xl md:text-5xl font-bold font-display text-white tracking-tight">Documentation</h1>
  </PageHero>

  <section class="py-16 bg-neutral-cream">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-5">
      {groups.map(({ title, icon, links }) => (
        <article class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8">
          <div class="w-12 h-12 rounded-xl bg-vibrant-100 text-vibrant-700 flex items-center justify-center mb-5">
            <svg class="w-6 h-6" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
            </svg>
          </div>
          <h2 class="text-xl font-bold font-display text-neutral-stone mb-3">{title}</h2>
          <ul class="divide-y divide-gray-100">
            {links.map(({ title, path }) => (
              <li>
                <a href={`${base}${path}`} class="group flex items-center justify-between gap-3 py-3 font-medium text-vibrant-700 hover:text-vibrant-800 hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vibrant-600">
                  {title}
                  <svg class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
