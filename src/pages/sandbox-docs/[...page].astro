---
// The Sandbox docs moved to /docs/sandbox/; old links land here.
import { getCollection } from 'astro:content';
import MovedPage from '../../components/MovedPage.astro';

export async function getStaticPaths() {
  const docs = await getCollection('sandboxDocs');
  return docs.map((entry) => ({ params: { page: entry.id === 'index' ? undefined : entry.id } }));
}

const { page } = Astro.params;
---

<MovedPage to={`/docs/sandbox/${page ? `${page}/` : ''}`} />
