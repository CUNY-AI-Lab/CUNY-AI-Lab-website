---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL;
const jsonPath = path.join(process.cwd(), 'src/data/request-access.json');
const data = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
---

<BaseLayout title="Request Access - CUNY AI Lab">
  <!-- Hero Section -->
  <PageHero containerClass="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold font-display text-white tracking-tight">{data.title}</h1>
  </PageHero>

  <!-- Main Content -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Introduction -->
      <div class="mb-16 text-center">
        <h2 class="text-3xl font-bold font-display text-neutral-stone mb-6">{data.intro_heading}</h2>
        <p class="text-lg text-gray-600 mb-4 leading-relaxed">
          {data.intro_description}
        </p>
        <p class="text-gray-600 mb-8 leading-relaxed">
          {data.eligibility_note}
        </p>
        <div class="bg-vibrant-50 border border-vibrant-200 rounded-2xl p-8 text-left shadow-sm">
          <h3 class="text-lg font-bold text-vibrant-900 mb-4 flex items-center">
            <svg class="w-6 h-6 mr-2 text-vibrant-600" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {data.features_heading}
          </h3>
          <ul class="space-y-3">
            {data.features.map((feature: string) => (
              <li class="flex items-start">
                <span class="w-2 h-2 bg-vibrant-400 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                <span class="text-gray-700">{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Lab Application -->
      <div class="bg-white border border-gray-200 rounded-2xl p-8 md:p-10 shadow-lg relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-vibrant-400 to-cuny-blue"></div>
        <h3 class="text-2xl font-bold font-display text-neutral-stone mb-8">{data.form_heading}</h3>

        <form
          id="access-request-form"
          method="post"
          action={data.intake_url}
          data-identity-url={data.identity_url}
          data-sign-in-url={data.sign_in_url}
          data-intake-url={data.intake_url}
          data-class-intake-url={data.class_intake_url}
          class="space-y-6"
          aria-describedby="form-status"
        >
          <fieldset>
            <legend class="block text-sm font-semibold text-gray-700 mb-3">
              {data.application_kind.legend} <span class="text-red-500">*</span>
            </legend>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="flex cursor-pointer items-start gap-3 rounded-xl border-2 border-gray-200 p-4 transition-colors has-[:checked]:border-vibrant-500 has-[:checked]:bg-vibrant-50">
                <input
                  type="radio"
                  name="application-kind"
                  value="individual"
                  checked
                  class="mt-1 h-5 w-5 border-gray-300 text-vibrant-600 focus:ring-vibrant-500"
                />
                <span>
                  <span class="block font-bold text-neutral-stone">{data.application_kind.individual.label}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-gray-600">{data.application_kind.individual.description}</span>
                </span>
              </label>
              <label class="flex cursor-pointer items-start gap-3 rounded-xl border-2 border-gray-200 p-4 transition-colors has-[:checked]:border-vibrant-500 has-[:checked]:bg-vibrant-50">
                <input
                  type="radio"
                  name="application-kind"
                  value="class"
                  class="mt-1 h-5 w-5 border-gray-300 text-vibrant-600 focus:ring-vibrant-500"
                />
                <span>
                  <span class="block font-bold text-neutral-stone">{data.application_kind.class.label}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-gray-600">{data.application_kind.class.description}</span>
                </span>
              </label>
            </div>
            <p class="mt-3 rounded-xl bg-gray-50 border border-gray-200 px-4 py-3 text-sm text-gray-700">
              <span class="font-semibold text-neutral-stone">{data.student_note.heading}</span>
              {' '}{data.student_note.text}
            </p>
          </fieldset>

          <div
            id="identity-status"
            class="rounded-xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-900"
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            <p id="identity-message">Checking your CUNY sign-in…</p>
            <a
              id="identity-sign-in"
              href={data.sign_in_url}
              class="mt-3 inline-flex items-center rounded-full bg-vibrant-700 px-4 py-2 font-semibold text-white hover:bg-vibrant-800 focus:outline-none focus:ring-2 focus:ring-vibrant-500 focus:ring-offset-2"
              hidden
            >
              Sign in with CUNY Login
            </a>
            <button
              type="button"
              id="identity-retry"
              class="mt-3 rounded-full border border-vibrant-700 px-4 py-2 font-semibold text-vibrant-800 hover:bg-vibrant-100 focus:outline-none focus:ring-2 focus:ring-vibrant-500 focus:ring-offset-2"
              hidden
            >
              Check again
            </button>
          </div>

          <!-- Name -->
          <div>
            <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
              {data.form_fields.name.label} <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              maxlength="160"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vibrant-500 focus:border-vibrant-500 transition-all bg-gray-50 focus:bg-white"
              placeholder={data.form_fields.name.placeholder}
            />
          </div>

          <!-- Verified identity -->
          <div aria-live="polite">
            <p class="block text-sm font-semibold text-gray-700 mb-2">
              {data.form_fields.email.label}
            </p>
            <p id="verified-email" class="text-base font-medium text-neutral-stone">
              Sign in with CUNY Login to load your verified email.
            </p>
          </div>

          <!-- CUNY Affiliation -->
          <div>
            <label for="affiliation" class="block text-sm font-semibold text-gray-700 mb-2">
              {data.form_fields.affiliation.label} <span class="text-red-500">*</span>
            </label>
            <select
              id="affiliation"
              name="affiliation"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vibrant-500 focus:border-vibrant-500 transition-all bg-gray-50 focus:bg-white"
            >
              {data.form_fields.affiliation.options.map((option: any) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </div>

          <!-- Department/Program -->
          <div>
            <label for="department" class="block text-sm font-semibold text-gray-700 mb-2">
              {data.form_fields.department.label} <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="department"
              name="department"
              required
              maxlength="240"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vibrant-500 focus:border-vibrant-500 transition-all bg-gray-50 focus:bg-white"
              placeholder={data.form_fields.department.placeholder}
            />
          </div>

          <!-- College/Campus -->
          <div>
            <label for="campus" class="block text-sm font-semibold text-gray-700 mb-2">
              {data.form_fields.campus.label} <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="campus"
              name="campus"
              required
              maxlength="120"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vibrant-500 focus:border-vibrant-500 transition-all bg-gray-50 focus:bg-white"
              placeholder={data.form_fields.campus.placeholder}
            />
          </div>

          <!-- Intended Use -->
          <div>
            <div id="class-application-guidance" class="mb-5 space-y-3 text-sm leading-relaxed text-gray-700" hidden>
              <p>{data.application_kind.class_capacity}</p>
              <p>{data.application_kind.class_pedagogy}</p>
            </div>
            <label for="intended-use" class="block text-sm font-semibold text-gray-700 mb-2">
              <span id="intended-use-label" data-individual-label={data.form_fields.intended_use.label} data-class-label={data.class_fields.intended_use.label}>{data.form_fields.intended_use.label}</span> <span class="text-red-500">*</span>
            </label>
            <p id="class-intended-use-help" class="mb-3 text-sm leading-relaxed text-gray-600" hidden>{data.class_fields.intended_use.help}</p>
            <textarea
              id="intended-use"
              name="intended-use"
              required
              rows="4"
              maxlength="4000"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vibrant-500 focus:border-vibrant-500 transition-all bg-gray-50 focus:bg-white"
              placeholder={data.form_fields.intended_use.placeholder}
              data-individual-placeholder={data.form_fields.intended_use.placeholder}
            ></textarea>
          </div>

          <!-- Individual application fields -->
          <fieldset id="individual-fields" data-application-fields="individual">
            <legend class="block text-sm font-semibold text-gray-700 mb-3">
              {data.tools_of_interest.label}
            </legend>
            <div class="space-y-3 bg-gray-50 p-4 rounded-lg border border-gray-200">
              {data.tools_of_interest.options.map((tool: any) => (
                <label class="flex items-center cursor-pointer hover:bg-gray-100 p-2 rounded transition-colors">
                  <input type="checkbox" name="tools[]" value={tool.value} class="w-5 h-5 text-vibrant-600 rounded focus:ring-vibrant-500 border-gray-300 mr-3" />
                  <span class="text-gray-700">{tool.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Class application fields -->
          <fieldset id="class-fields" data-application-fields="class" disabled hidden aria-hidden="true">
            <legend class="block text-sm font-semibold text-gray-700 mb-3">Class details</legend>
            <p class="mb-5 rounded-xl border border-blue-200 bg-blue-50 p-4 text-sm leading-relaxed text-blue-900">
              {data.application_kind.class_note}
            </p>
            <div class="grid gap-5 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label for="class-name" class="block text-sm font-semibold text-gray-700 mb-2">
                  {data.class_fields.class_name.label} <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="class-name"
                  name="className"
                  data-required
                  maxlength="200"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vibrant-500 focus:border-vibrant-500 transition-all bg-gray-50 focus:bg-white"
                  placeholder={data.class_fields.class_name.placeholder}
                />
              </div>
              <div>
                <label for="term" class="block text-sm font-semibold text-gray-700 mb-2">
                  {data.class_fields.term.label} <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="term"
                  name="term"
                  data-required
                  maxlength="120"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vibrant-500 focus:border-vibrant-500 transition-all bg-gray-50 focus:bg-white"
                  placeholder={data.class_fields.term.placeholder}
                />
              </div>
              <div>
                <label for="section" class="block text-sm font-semibold text-gray-700 mb-2">
                  {data.class_fields.section.label} <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="section"
                  name="section"
                  data-required
                  maxlength="120"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vibrant-500 focus:border-vibrant-500 transition-all bg-gray-50 focus:bg-white"
                  placeholder={data.class_fields.section.placeholder}
                />
              </div>
              <div>
                <label for="starts-on" class="block text-sm font-semibold text-gray-700 mb-2">
                  {data.class_fields.starts_on.label} <span class="text-red-500">*</span>
                </label>
                <input
                  type="date"
                  id="starts-on"
                  name="startsOn"
                  data-required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vibrant-500 focus:border-vibrant-500 transition-all bg-gray-50 focus:bg-white"
                />
              </div>
              <div>
                <label for="ends-on" class="block text-sm font-semibold text-gray-700 mb-2">
                  {data.class_fields.ends_on.label} <span class="text-red-500">*</span>
                </label>
                <input
                  type="date"
                  id="ends-on"
                  name="endsOn"
                  data-required
                  aria-describedby="ends-on-help"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vibrant-500 focus:border-vibrant-500 transition-all bg-gray-50 focus:bg-white"
                />
                <p id="ends-on-help" class="mt-2 text-xs text-gray-500">{data.class_fields.ends_on.help}</p>
              </div>
              <div>
                <label for="estimated-seats" class="block text-sm font-semibold text-gray-700 mb-2">
                  {data.class_fields.estimated_seats.label} <span class="text-red-500">*</span>
                </label>
                <input
                  type="number"
                  id="estimated-seats"
                  name="estimatedSeats"
                  data-required
                  min="1"
                  max="100000"
                  step="1"
                  inputmode="numeric"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vibrant-500 focus:border-vibrant-500 transition-all bg-gray-50 focus:bg-white"
                  placeholder={data.class_fields.estimated_seats.placeholder}
                />
              </div>
            </div>
            <label for="class-leader" class="mt-5 flex items-center gap-3 text-sm font-semibold text-gray-700">
              <input
                type="checkbox"
                id="class-leader"
                name="classLeader"
                data-required
                class="h-5 w-5 rounded border-gray-300 text-vibrant-600 focus:ring-vibrant-500"
              />
              <span>I teach or lead this class</span>
            </label>
          </fieldset>

          <div>
            <div
              id="access-verification"
              data-sitekey={data.turnstile_site_key}
            ></div>
            <p id="verification-status" class="text-sm text-gray-700 mt-2" role="status" aria-live="polite">Loading verification…</p>
            <button id="verification-retry" type="button" class="mt-2 text-sm font-semibold text-vibrant-700 underline" hidden>Retry verification</button>
          </div>

          <!-- Submit Button -->
          <div class="pt-6">
            <button
              type="submit"
              id="access-request-submit"
              disabled
              class="w-full bg-vibrant-700 text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-vibrant-800 transition-all shadow-lg hover:shadow-vibrant-500/30 transform hover:-translate-y-1 disabled:opacity-60 disabled:cursor-not-allowed disabled:transform-none"
            >
              {data.submit_text}
            </button>
          </div>

          <div id="form-status" class="rounded-xl px-4 py-3 text-sm font-medium" role="status" aria-live="polite" tabindex="-1" hidden></div>

          <!-- Privacy Note -->
          <p class="text-xs text-gray-500 mt-6 text-center">
            {data.privacy_note}
          </p>
        </form>

        <div id="submission-confirmation" class="py-8 text-center" role="region" aria-labelledby="confirmation-heading" tabindex="-1" hidden>
          <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-green-100 text-green-700" aria-hidden="true">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 id="confirmation-heading" class="text-3xl font-bold font-display text-neutral-stone">Thank you</h3>
          <p id="confirmation-message" class="mt-4 text-lg text-gray-700"></p>
          <a href={`${base}tools/`} class="mt-8 inline-flex items-center rounded-full bg-vibrant-700 px-6 py-3 font-semibold text-white hover:bg-vibrant-800 focus:outline-none focus:ring-2 focus:ring-vibrant-500 focus:ring-offset-2">
            Go to CAIL tools
          </a>
        </div>
      </div>

      <!-- What Happens Next -->
      <div class="mt-16 bg-neutral-cream p-8 rounded-2xl border border-gray-100">
        <h3 class="text-xl font-bold font-display text-neutral-stone mb-6">{data.next_steps_heading}</h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          {data.next_steps.map((step: any) => (
            <div class="relative">
              <div class="w-10 h-10 rounded-full bg-vibrant-100 text-vibrant-600 flex items-center justify-center font-bold mb-3">{step.step}</div>
              <h4 class="font-bold text-gray-900 mb-1">{step.title}</h4>
              {step.description_html ? (
                <p class="text-sm text-gray-600" set:html={step.description_html} />
              ) : (
                <p class="text-sm text-gray-600">{step.description}</p>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Questions -->
      <div class="mt-12 text-center">
        <p class="text-gray-600 mb-4">
          {data.questions_text}
        </p>
        <a href={`${base}contact`} class="inline-block text-vibrant-700 hover:text-vibrant-900 font-semibold transition-colors">
          {data.questions_link_text}
        </a>
      </div>
    </div>
  </section>

  <script>
    import * as z from 'zod/mini';

    const form = document.querySelector<HTMLFormElement>('#access-request-form');
    const submit = document.querySelector<HTMLButtonElement>('#access-request-submit');
    const status = document.querySelector<HTMLElement>('#form-status');
    const identityStatus = document.querySelector<HTMLElement>('#identity-status');
    const identityMessage = document.querySelector<HTMLElement>('#identity-message');
    const identitySignIn = document.querySelector<HTMLAnchorElement>('#identity-sign-in');
    const identityRetry = document.querySelector<HTMLButtonElement>('#identity-retry');
    const verification = document.querySelector<HTMLElement>('#access-verification');
    const verificationStatus = document.querySelector<HTMLElement>('#verification-status');
    const verificationRetry = document.querySelector<HTMLButtonElement>('#verification-retry');
    const intendedUse = document.querySelector<HTMLTextAreaElement>('#intended-use');
    const intendedUseLabel = document.querySelector<HTMLElement>('#intended-use-label');
    const classGuidance = document.querySelector<HTMLElement>('#class-application-guidance');
    const classIntendedUseHelp = document.querySelector<HTMLElement>('#class-intended-use-help');
    const emailDisplay = document.querySelector<HTMLElement>('#verified-email');
    const confirmation = document.querySelector<HTMLElement>('#submission-confirmation');
    const confirmationMessage = document.querySelector<HTMLElement>('#confirmation-message');
    const kindInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="application-kind"]'));
    const modeSections = Array.from(document.querySelectorAll<HTMLFieldSetElement>('[data-application-fields]'));
    const submitLabel = submit?.textContent?.trim() ?? 'Submit Application';
    const identityUrl = form?.dataset.identityUrl ?? '';
    const signInUrl = form?.dataset.signInUrl ?? '';
    let pendingApplication: { clientRequestId: string; fingerprint: string } | null = null;
    let verifiedEmail: string | null = null;
    let identityReady = false;
    let verificationReady = false;
    let submitting = false;

    type TurnstileWindow = Window & {
      turnstile?: {
        render: (container: HTMLElement, options: {
          sitekey: string;
          theme: 'auto';
          size: 'flexible';
          callback: (token: string) => void;
          'expired-callback': () => void;
          'error-callback': () => void;
          'timeout-callback': () => void;
          'unsupported-callback': () => void;
        }) => string;
        reset: (container: HTMLElement) => void;
      };
    };
    const identitySchema = z.object({ email: z.string() });
    const intakeOutcomeSchema = z.object({
      requestId: z.optional(z.string()),
      error: z.optional(z.object({ code: z.optional(z.string()) })),
    });
    type IntakeOutcome = z.infer<typeof intakeOutcomeSchema>;
    type CommonApplicationFields = {
      name: string;
      affiliation: string;
      department: string;
      campus: string;
      intendedUse: string;
    };
    type ClassApplicationFields = CommonApplicationFields & {
      className: string;
      term: string;
      section: string;
      startsOn: string;
      endsOn: string;
      estimatedSeats: number;
    };
    type IndividualApplicationFields = CommonApplicationFields & { tools: string[] };

    function textField(fields: FormData, name: string): string {
      const value = fields.get(name);
      return value === null || value instanceof File ? '' : value;
    }

    function textFields(fields: FormData, name: string): string[] {
      return fields.getAll(name).flatMap((value) => (value instanceof File ? [] : [value]));
    }

    function showStatus(message: string, outcome: 'success' | 'error') {
      if (!status) return;
      status.hidden = false;
      status.textContent = message;
      status.className =
        outcome === 'success'
          ? 'rounded-xl px-4 py-3 text-sm font-medium bg-green-50 text-green-800 border border-green-200'
          : 'rounded-xl px-4 py-3 text-sm font-medium bg-red-50 text-red-800 border border-red-200';
      status.focus();
    }

    function updateSubmit() {
      if (submit) submit.disabled = !identityReady || !verificationReady || submitting;
    }

    function setVerification(message: string, ready: boolean, retry = false) {
      verificationReady = ready;
      if (verificationStatus) verificationStatus.textContent = message;
      if (verificationRetry) verificationRetry.hidden = !retry;
      updateSubmit();
    }

    function resetTurnstile() {
      setVerification('Verification is refreshing. Your entries have been kept.', false);
      // SAFETY: the external script installs this API; it may be absent if loading failed.
      const api = (window as TurnstileWindow).turnstile;
      if (api && verification) api.reset(verification);
    }

    function loadVerification() {
      if (!verification) return;
      setVerification('Loading verification…', false);
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.addEventListener('error', () => {
        script.remove();
        setVerification('Verification could not load. Check your connection or browser blocking settings, then retry.', false, true);
      });
      script.addEventListener('load', () => {
        // SAFETY: the loaded Cloudflare script provides the documented Turnstile API.
        const api = (window as TurnstileWindow).turnstile;
        if (!api) {
          script.remove();
          setVerification('Verification could not load. Please retry.', false, true);
          return;
        }
        setVerification('Complete the verification before sending your request.', false);
        api.render(verification, {
          sitekey: verification.dataset.sitekey ?? '',
          theme: 'auto',
          size: 'flexible',
          callback: (token) => setVerification('Verification complete.', token.length > 0),
          'expired-callback': () => setVerification('Verification expired and is refreshing. Your entries have been kept.', false, true),
          'error-callback': () => setVerification('Verification could not be completed. Please retry. Your entries have been kept.', false, true),
          'timeout-callback': () => setVerification('Verification timed out. Please retry. Your entries have been kept.', false, true),
          'unsupported-callback': () => setVerification('Verification does not support this browser. Try an updated browser.', false),
        });
      });
      document.head.append(script);
    }

    function setIdentityStatus(
      message: string,
      outcome: 'loading' | 'signed-out' | 'ready' | 'error',
    ) {
      if (!identityMessage || !identityStatus) return;
      identityMessage.textContent = message;
      if (identitySignIn) {
        identitySignIn.hidden = outcome === 'ready' || outcome === 'loading';
        identitySignIn.href = signInUrl;
      }
      if (identityRetry) identityRetry.hidden = outcome !== 'error' && outcome !== 'signed-out';
      identityStatus.className =
        outcome === 'ready'
          ? 'rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-900'
          : outcome === 'error'
            ? 'rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900'
            : outcome === 'signed-out'
              ? 'rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950'
              : 'rounded-xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-900';
    }

    function resetIdentity() {
      identityReady = false;
      verifiedEmail = null;
      if (emailDisplay) emailDisplay.textContent = 'Sign in with CUNY Login to load your verified email.';
      if (submit) submit.disabled = true;
    }

    function requireSignIn(message: string) {
      resetIdentity();
      setIdentityStatus(message, 'signed-out');
    }

    async function loadIdentity() {
      resetIdentity();
      setIdentityStatus('Checking your CUNY sign-in…', 'loading');

      try {
        const response = await fetch(identityUrl, {
          method: 'GET',
          headers: { accept: 'application/json' },
          credentials: 'include',
          cache: 'no-store',
        });
        if (response.status === 401) {
          requireSignIn('Sign in with CUNY Login before submitting an access request.');
          return;
        }
        if (!response.ok) {
          setIdentityStatus('We could not verify your CUNY sign-in. Try again shortly.', 'error');
          return;
        }

        const identity = identitySchema.safeParse(await response.json().catch(() => null));
        const email = identity.success ? identity.data.email.trim() : '';
        if (!email) {
          setIdentityStatus('We could not verify your CUNY sign-in. Try again shortly.', 'error');
          return;
        }

        verifiedEmail = email;
        identityReady = true;
        if (emailDisplay) emailDisplay.textContent = email;
        setIdentityStatus('Signed in with CUNY Login. We will use this verified email for your request.', 'ready');
        updateSubmit();
      } catch {
        setIdentityStatus('We could not verify your CUNY sign-in. Try again shortly.', 'error');
      }
    }

    function clientRequestIdFor(fingerprint: string) {
      if (pendingApplication?.fingerprint === fingerprint) return pendingApplication.clientRequestId;
      const clientRequestId = crypto.randomUUID();
      pendingApplication = { clientRequestId, fingerprint };
      return clientRequestId;
    }

    function setApplicationKind(kind: 'individual' | 'class', updateUrl: boolean) {
      for (const input of kindInputs) input.checked = input.value === kind;
      if (classGuidance) classGuidance.hidden = kind !== 'class';
      if (classIntendedUseHelp) classIntendedUseHelp.hidden = kind !== 'class';
      if (intendedUseLabel) {
        intendedUseLabel.textContent = (kind === 'class'
          ? intendedUseLabel.dataset.classLabel
          : intendedUseLabel.dataset.individualLabel) ?? '';
      }
      if (intendedUse) {
        intendedUse.placeholder = kind === 'class' ? '' : (intendedUse.dataset.individualPlaceholder ?? '');
        if (kind === 'class') intendedUse.setAttribute('aria-describedby', 'class-intended-use-help');
        else intendedUse.removeAttribute('aria-describedby');
        intendedUse.setCustomValidity('');
      }
      if (form) {
        form.action = kind === 'class'
          ? (form.dataset.classIntakeUrl ?? form.action)
          : (form.dataset.intakeUrl ?? form.action);
      }
      for (const section of modeSections) {
        const active = section.dataset.applicationFields === kind;
        section.hidden = !active;
        section.disabled = !active;
        section.setAttribute('aria-hidden', String(!active));
        for (const field of section.querySelectorAll<HTMLInputElement>('[data-required]')) {
          field.required = active;
        }
      }

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set('kind', kind);
        window.history.replaceState(null, '', url);
      }
    }

    function isIsoDate(value: FormDataEntryValue | null): value is string {
      if (value === null || value instanceof File || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
      const date = new Date(`${value}T00:00:00.000Z`);
      return !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === value;
    }

    for (const input of kindInputs) {
      input.addEventListener('change', () => {
        if (input.checked) setApplicationKind(input.value === 'class' ? 'class' : 'individual', true);
      });
    }

    const initialKind = new URLSearchParams(window.location.search).get('kind') === 'class' ? 'class' : 'individual';
    setApplicationKind(initialKind, false);
    identityRetry?.addEventListener('click', () => void loadIdentity());
    verificationRetry?.addEventListener('click', () => {
      // SAFETY: the optional API is installed only after the external script loads.
      if ((window as TurnstileWindow).turnstile) resetTurnstile();
      else loadVerification();
    });
    intendedUse?.addEventListener('input', () => intendedUse.setCustomValidity(''));
    void loadIdentity();
    loadVerification();

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!submit || submitting) return;
      if (intendedUse) {
        const text = intendedUse.value.replace(/\r\n?/g, '\n');
        const hasControlCharacter = Array.from(text).some((character) => {
          const code = character.charCodeAt(0);
          return (code < 32 && code !== 9 && code !== 10) || code === 127;
        });
        intendedUse.setCustomValidity(!text.trim()
          ? 'Describe how you plan to use the Lab or what help you need.'
          : Array.from(text).length > 4000
            ? 'Keep your response to 4,000 characters or fewer.'
            : hasControlCharacter
              ? 'Remove unsupported control characters from your response.'
              : '');
      }
      if (!form.reportValidity()) return;

      if (!identityReady || verifiedEmail === null) {
        requireSignIn('Sign in with CUNY Login before submitting an access request.');
        identitySignIn?.focus();
        return;
      }

      const fields = new FormData(form);
      const kind = fields.get('application-kind') === 'class' ? 'class' : 'individual';
      const turnstileToken = textField(fields, 'cf-turnstile-response');
      if (!verificationReady || turnstileToken.length === 0) {
        if (verificationReady) resetTurnstile();
        return;
      }

      submitting = true;
      updateSubmit();
      submit.textContent = 'Sending request…';
      if (status) status.hidden = true;

      try {
        const common = {
          name: textField(fields, 'name'),
          affiliation: textField(fields, 'affiliation'),
          department: textField(fields, 'department'),
          campus: textField(fields, 'campus'),
          intendedUse: textField(fields, 'intended-use'),
        };
        let applicationFields: ClassApplicationFields | IndividualApplicationFields;
        if (kind === 'class') {
          const startsOn = fields.get('startsOn');
          const endsOn = fields.get('endsOn');
          if (!isIsoDate(startsOn) || !isIsoDate(endsOn)) {
            showStatus('Enter valid class start and end dates.', 'error');
            document.querySelector<HTMLInputElement>(isIsoDate(startsOn) ? '#ends-on' : '#starts-on')?.focus();
            return;
          }
          if (endsOn < startsOn) {
            showStatus('The class end date must be on or after the start date.', 'error');
            document.querySelector<HTMLInputElement>('#ends-on')?.focus();
            return;
          }

          const estimatedSeats = Number(fields.get('estimatedSeats'));
          if (!Number.isSafeInteger(estimatedSeats) || estimatedSeats < 1 || estimatedSeats > 100000) {
            showStatus('Enter a whole number from 1 to 100,000 for estimated enrollment.', 'error');
            document.querySelector<HTMLInputElement>('#estimated-seats')?.focus();
            return;
          }

          applicationFields = {
            ...common,
            className: textField(fields, 'className'),
            term: textField(fields, 'term'),
            section: textField(fields, 'section'),
            startsOn,
            endsOn,
            estimatedSeats,
          };
        } else {
          applicationFields = {
            ...common,
            tools: textFields(fields, 'tools[]'),
          };
        }

        // A refreshed Turnstile token does not change the application being retried.
        const fingerprint = JSON.stringify({ kind, verifiedEmail, ...applicationFields });
        const payload = {
          clientRequestId: clientRequestIdFor(fingerprint),
          turnstileToken,
          ...applicationFields,
        };

        const intakeUrl = kind === 'class' ? form.dataset.classIntakeUrl : form.dataset.intakeUrl;
        const response = await fetch(intakeUrl ?? '', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(payload),
        });
        const outcome = intakeOutcomeSchema.safeParse(await response.json().catch(() => null));
        const result: IntakeOutcome = outcome.success ? outcome.data : {};
        if (response.status === 201 && result.requestId !== undefined) {
          pendingApplication = null;
          form.hidden = true;
          if (confirmationMessage) {
            confirmationMessage.textContent = kind === 'class'
              ? 'Your class application has been submitted. The CUNY AI Lab will review it and contact you by email.'
              : 'Your application has been submitted. The CUNY AI Lab will review it and contact you by email.';
          }
          if (confirmation) {
            confirmation.hidden = false;
            confirmation.focus();
          }
          return;
        }

        resetTurnstile();
        if (response.status === 401) {
          requireSignIn('Your CUNY sign-in expired. Sign in again before resending this request.');
          identitySignIn?.focus();
        } else if (response.status === 403 && result.error?.code === 'turnstile_failed') {
          showStatus('The verification expired or could not be confirmed. Complete it again and resend the request.', 'error');
        } else if (response.status === 400) {
          showStatus('Check the form fields and resend the request.', 'error');
        } else {
          showStatus('The access service is temporarily unavailable. Try again shortly.', 'error');
        }
      } catch {
        resetTurnstile();
        showStatus('The access service could not be reached. Check your connection and try again.', 'error');
      } finally {
        submitting = false;
        updateSubmit();
        submit.textContent = submitLabel;
      }
    });
  </script>
</BaseLayout>
