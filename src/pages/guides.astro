---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const base = import.meta.env.BASE_URL;
const sidebarRowBase = 'guide-category-tab flex items-center gap-3 w-full text-left rounded-lg px-3 py-2.5 text-sm transition-colors border-l-[3px]';
const sidebarRowInactive = `${sidebarRowBase} border-transparent text-gray-600 font-medium hover:bg-white/70 hover:text-neutral-stone`;
const categories = [
  { id: 'vibe-coding', label: 'Vibe Coding Workshop Series', iconPath: 'M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5', iconBackground: 'bg-vibrant-100', iconColor: 'text-vibrant-600', activeClass: `${sidebarRowBase} bg-white border-vibrant-500 text-neutral-stone font-semibold shadow-sm` },
  { id: 'sandbox', label: 'Sandbox Workshop Series', iconPath: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332-.477-4.5-1.253', iconBackground: 'bg-amber-100', iconColor: 'text-amber-600', activeClass: `${sidebarRowBase} bg-white border-amber-500 text-neutral-stone font-semibold shadow-sm` },
  { id: 'pedagogy-labs', label: 'Interactive Technology and Pedagogy Labs', iconPath: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332-.477-4.5-1.253', iconBackground: 'bg-indigo-100', iconColor: 'text-indigo-600', activeClass: `${sidebarRowBase} bg-white border-indigo-500 text-neutral-stone font-semibold shadow-sm` },
];
const cardBase = 'group block h-full bg-white rounded-xl border border-gray-100 hover:border-vibrant-300 hover:shadow-lg transition-all p-6';
const externalIcon = 'M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14';
---

<BaseLayout title="Guides & Tutorials - CUNY AI Lab">
  <PageHero>
    <h1 class="text-4xl md:text-5xl font-bold font-display text-white tracking-tight">Guides &amp; Tutorials</h1>
    <p class="mt-4 text-vibrant-200/80 text-lg max-w-2xl">Slide decks, written guides, and workshop materials produced by the CUNY AI Lab.</p>
  </PageHero>

  <section class="bg-neutral-cream min-h-[60vh]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="mb-6 lg:hidden">
        <label for="guide-category" class="block text-xs font-semibold uppercase tracking-wide text-gray-500 mb-1.5">Category</label>
        <div class="relative">
          <select id="guide-category" class="w-full appearance-none rounded-xl border-2 border-vibrant-100 bg-white px-4 py-3 pr-11 font-medium text-vibrant-800 focus:border-vibrant-500 focus:outline-none">
            {categories.map((category) => <option value={category.id}>{category.label}</option>)}
          </select>
          <svg class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-vibrant-700" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </div>
      </div>

      <div class="guides-layout">
        <aside class="guide-sidebar hidden lg:block">
          <div class="sticky top-24">
            <p class="px-3 pb-2 text-xs font-semibold uppercase tracking-wide text-gray-500" aria-hidden="true">Categories</p>
            <div class="space-y-1" role="tablist" aria-label="Guide categories" aria-orientation="vertical">
              {categories.map((category, index) => {
                const selected = index === 0;
                return <button type="button" class={selected ? category.activeClass : sidebarRowInactive} data-active-class={category.activeClass} data-inactive-class={sidebarRowInactive} data-panel={category.id} role="tab" aria-selected={selected ? 'true' : 'false'} aria-controls={`panel-${category.id}`} tabindex={selected ? '0' : '-1'}><span class={`w-8 h-8 rounded-lg ${category.iconBackground} flex items-center justify-center flex-shrink-0`}><svg class={`w-4 h-4 ${category.iconColor}`} aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={category.iconPath} /></svg></span><span>{category.label}</span></button>;
              })}
            </div>
          </div>
        </aside>

        <div class="min-w-0">
          <section id="panel-vibe-coding" class="guide-panel" role="tabpanel" aria-label="Vibe Coding Workshop Series">
            <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden p-8 lg:p-10">
              <h2 class="text-3xl font-bold font-display text-neutral-stone">Vibe Coding Workshop Series</h2>
              <p class="text-gray-500 mt-1 mb-7">Build digital projects with AI coding assistants, from foundations through working prototypes.</p>
              <div class="grid md:grid-cols-2 gap-6">
                <a href="https://cuny-ai-lab.github.io/gen-dev-foundations/" target="_blank" rel="noopener noreferrer" class={cardBase}>
                  <span class="inline-flex px-2.5 py-0.5 mb-3 bg-vibrant-50 text-vibrant-700 text-xs font-medium rounded-full">Part 1</span>
                  <h3 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-vibrant-600">Foundations: AI, Command Line, and Version Control</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">Core concepts for AI-assisted development, including environment setup, terminal basics, and Git workflows.</p>
                </a>
                <a href="https://cuny-ai-lab.github.io/vibe-coding-prototypes" target="_blank" rel="noopener noreferrer" class={cardBase}>
                  <span class="inline-flex px-2.5 py-0.5 mb-3 bg-vibrant-50 text-vibrant-700 text-xs font-medium rounded-full">Part 2</span>
                  <h3 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-vibrant-600">Vibe-Coding Prototypes</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">Building prototypes with AI coding assistants, including prompting strategies, project design, and troubleshooting.</p>
                </a>
              </div>

              <section aria-labelledby="development-guides-title" class="mt-9 pt-8 border-t border-gray-200">
                <h3 id="development-guides-title" class="text-xl font-bold font-display text-neutral-stone mb-5">Development Guides</h3>
                <div class="grid md:grid-cols-2 gap-6">
                  <a href="https://cuny-ai-lab.github.io/vibe-coding-how-to/" target="_blank" rel="noopener noreferrer" class={cardBase}>
                    <h4 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-vibrant-600">AI-Assisted Development Guide</h4>
                    <p class="text-gray-600 text-sm leading-relaxed">A step-by-step written tutorial on building digital projects with AI coding assistants. Covers environment setup, prompting strategies, and project workflows for beginners.</p>
                    <span class="inline-flex items-center gap-2 mt-4 text-vibrant-600 font-semibold text-sm">Read the guide <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={externalIcon} /></svg></span>
                  </a>
                  <a href={`${base}docs/cail-pi`} class={cardBase}>
                    <h4 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-vibrant-600">CAIL Pi</h4>
                    <p class="text-gray-600 text-sm leading-relaxed">Install Pi, the terminal coding agent used in the workshops, connect it to CUNY AI Lab models, and sign in with your CUNY account.</p>
                    <span class="inline-flex items-center gap-2 mt-4 text-vibrant-600 font-semibold text-sm">Setup guide <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></span>
                  </a>
                </div>
              </section>
            </div>
          </section>

          <section id="panel-sandbox" class="guide-panel hidden" role="tabpanel" aria-label="Sandbox Workshop Series">
            <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden p-8 lg:p-10">
              <h2 class="text-3xl font-bold font-display text-neutral-stone">Sandbox Workshop Series</h2>
              <p class="text-gray-500 mt-1 mb-8">Slides from our workshop series, available for independent review or reuse.</p>

              <section aria-labelledby="adventure-series-title" class="mb-10">
                <h3 id="adventure-series-title" class="text-xl font-bold font-display text-neutral-stone mb-5">Adventure Game Series</h3>
                <div class="grid md:grid-cols-3 gap-5">
                  <a href="https://cuny-ai-lab.github.io/sandbox-series/basics/" target="_blank" rel="noopener noreferrer" class={cardBase}>
                    <span class="inline-flex px-2.5 py-0.5 mb-3 bg-amber-50 text-amber-700 text-xs font-medium rounded-full">Part 1</span>
                    <h4 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-amber-600">Composing System Prompts</h4>
                    <p class="text-gray-600 text-sm leading-relaxed">Write your adventure’s rules and setting.</p>
                  </a>
                  <a href="https://cuny-ai-lab.github.io/sandbox-series/knowledge/" target="_blank" rel="noopener noreferrer" class={cardBase}>
                    <span class="inline-flex px-2.5 py-0.5 mb-3 bg-amber-50 text-amber-700 text-xs font-medium rounded-full">Part 2</span>
                    <h4 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-amber-600">Curating Knowledge Collections</h4>
                    <p class="text-gray-600 text-sm leading-relaxed">Build your adventure around course materials.</p>
                  </a>
                  <a href="https://cuny-ai-lab.github.io/sandbox-series/skills/" target="_blank" rel="noopener noreferrer" class={cardBase}>
                    <span class="inline-flex px-2.5 py-0.5 mb-3 bg-amber-50 text-amber-700 text-xs font-medium rounded-full">Part 3</span>
                    <h4 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-amber-600">Configuring Skills and Tools</h4>
                    <p class="text-gray-600 text-sm leading-relaxed">Add skills and tools to your game.</p>
                  </a>
                </div>
              </section>

              <section aria-labelledby="foundations-series-title" class="mb-9 pt-8 border-t border-gray-200">
                <h3 id="foundations-series-title" class="text-xl font-bold font-display text-neutral-stone mb-5">Workspace Foundations Series</h3>
                <div class="grid md:grid-cols-3 gap-5">
                  <a href="https://cuny-ai-lab.github.io/system-prompting/" target="_blank" rel="noopener noreferrer" class={cardBase}>
                    <span class="inline-flex px-2.5 py-0.5 mb-3 bg-amber-50 text-amber-700 text-xs font-medium rounded-full">Part 1</span>
                    <h4 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-amber-600">System Prompting</h4>
                    <p class="text-gray-600 text-sm leading-relaxed">How to craft effective system prompts to shape AI behavior for classroom use cases and custom assistants.</p>
                  </a>
                  <a href="https://cuny-ai-lab.github.io/knowledge-collections/" target="_blank" rel="noopener noreferrer" class={cardBase}>
                    <span class="inline-flex px-2.5 py-0.5 mb-3 bg-amber-50 text-amber-700 text-xs font-medium rounded-full">Part 2</span>
                    <h4 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-amber-600">Knowledge Collections</h4>
                    <p class="text-gray-600 text-sm leading-relaxed">Building and managing knowledge collections to ground AI responses in course materials and curated sources.</p>
                  </a>
                  <a href="https://cuny-ai-lab.github.io/sandbox-series/skills/" target="_blank" rel="noopener noreferrer" class={cardBase}>
                    <span class="inline-flex px-2.5 py-0.5 mb-3 bg-amber-50 text-amber-700 text-xs font-medium rounded-full">Part 3</span>
                    <h4 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-amber-600">Skills and Tools</h4>
                    <p class="text-gray-600 text-sm leading-relaxed">Customizing agentic tools and skills to extend AI assistant capabilities for specialized classroom workflows.</p>
                  </a>
                </div>
              </section>

              <section aria-labelledby="sandbox-documentation-title" class="pt-8 border-t border-gray-200">
                <h3 id="sandbox-documentation-title" class="text-xl font-bold font-display text-neutral-stone mb-2">Sandbox Documentation</h3>
                <p class="text-gray-600 text-sm leading-relaxed mb-5">Guides to getting started, designing custom models, and using the CAIL Sandbox for teaching and research.</p>
                <a href={`${base}sandbox-docs`} class="inline-flex items-center gap-2 px-6 py-3 bg-vibrant-600 text-white rounded-full font-medium hover:bg-vibrant-700 transition-colors shadow-md">
                  Browse Sandbox Docs
                  <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={externalIcon} /></svg>
                </a>
              </section>
            </div>
          </section>

          <section id="panel-pedagogy-labs" class="guide-panel hidden" role="tabpanel" aria-label="Interactive Technology and Pedagogy Labs">
            <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden p-8 lg:p-10">
              <h2 class="text-3xl font-bold font-display text-neutral-stone">Interactive Technology and Pedagogy Labs</h2>
              <div class="grid md:grid-cols-2 gap-6 mt-7">
                <a href="https://cuny-ai-lab.github.io/creative-coding" target="_blank" rel="noopener noreferrer" class={cardBase}>
                  <h3 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-vibrant-600">Creative Coding</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">Make generative art with AI.</p>
                </a>
                <a href="https://cuny-ai-lab.github.io/critical-play/" target="_blank" rel="noopener noreferrer" class={cardBase}>
                  <h3 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-vibrant-600">Critical Play</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">Examine AI through play.</p>
                </a>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var tabs = Array.from(document.querySelectorAll('.guide-category-tab'));
      var panels = Array.from(document.querySelectorAll('.guide-panel'));
      var select = document.getElementById('guide-category');
      if (!tabs.length || !panels.length) return;

      function activate(id, updateHash, scrollToPanel) {
        panels.forEach(function (panel) {
          var active = panel.id === 'panel-' + id;
          panel.classList.toggle('hidden', !active);
          panel.style.opacity = active ? '1' : '0';
        });
        tabs.forEach(function (tab) {
          var active = tab.dataset.panel === id;
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
          tab.tabIndex = active ? 0 : -1;
          tab.className = active ? tab.dataset.activeClass : tab.dataset.inactiveClass;
        });
        if (select) select.value = id;
        if (updateHash) history.replaceState(null, '', '#' + id);
        if (scrollToPanel && window.innerWidth < 1024) {
          var panel = document.getElementById('panel-' + id);
          if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () { activate(tab.dataset.panel, true, true); });
      });
      if (select) select.addEventListener('change', function () { activate(select.value, true, false); });
      var tablist = document.querySelector('[role="tablist"]');
      tablist.addEventListener('keydown', function (event) {
        var index = tabs.indexOf(document.activeElement);
        if (index < 0) return;
        var next;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        tabs[next].focus();
        tabs[next].click();
      });

      var ids = tabs.map(function (tab) { return tab.dataset.panel; });
      function validHash() {
        var id = (location.hash || '').slice(1);
        return ids.indexOf(id) >= 0 ? id : null;
      }
      activate(validHash() || ids[0], false, false);
      window.addEventListener('hashchange', function () {
        var id = validHash();
        if (id) activate(id, false, true);
      });
    })();
  </script>
</BaseLayout>

<style is:global>
  .guide-panel { transition: opacity 0.25s ease-in-out; }
  @media (min-width: 1024px) {
    .guides-layout { display: grid; grid-template-columns: 240px 1fr; gap: 2rem; }
    .guide-sidebar { display: block !important; }
  }
</style>
