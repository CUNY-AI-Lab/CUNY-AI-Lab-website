---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Guides & Tutorials - CUNY AI Lab">
  <!-- Hero Section -->
  <PageHero>
      <h1 class="text-4xl md:text-5xl font-bold font-display text-white tracking-tight">Guides & Tutorials</h1>
      <p class="mt-4 text-vibrant-200/80 text-lg max-w-2xl">Slide decks, written guides, and workshop materials produced by the CUNY AI Lab.</p>
  </PageHero>

  <!-- AI-Assisted Development Guide (standalone) -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="https://cuny-ai-lab.github.io/vibe-coding-how-to/" target="_blank" rel="noopener noreferrer" class="group block bg-gradient-to-br from-indigo-50 to-vibrant-50 rounded-2xl border border-transparent hover:border-vibrant-400 hover:shadow-xl transition-all p-8 md:p-10">
        <div class="flex flex-col md:flex-row md:items-center gap-6">
          <div class="w-14 h-14 rounded-xl bg-indigo-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
          </div>
          <div class="flex-1">
            <h2 class="text-2xl font-bold font-display text-neutral-stone mb-2 group-hover:text-vibrant-600 transition-colors">AI-Assisted Development Guide</h2>
            <p class="text-gray-600 leading-relaxed">A step-by-step written tutorial on building digital projects with AI coding assistants. Covers environment setup, prompting strategies, and project workflows for beginners.</p>
          </div>
          <div class="flex-shrink-0">
            <span class="inline-flex items-center gap-2 text-vibrant-600 font-semibold text-sm group-hover:gap-3 transition-all">
              Read the guide
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- Workshop Slide Decks -->
  <section class="py-16 bg-neutral-cream">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold font-display text-neutral-stone mb-3">Workshop Slide Decks</h2>
      <p class="text-gray-600 leading-relaxed mb-10 max-w-3xl">Slides from our <a href="/events" class="text-vibrant-600 hover:text-vibrant-700 underline underline-offset-2">workshop series</a>, available for independent review or reuse.</p>

      <!-- Vibe Coding Workshop Series -->
      <div class="mb-12">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-lg bg-vibrant-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-vibrant-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
            </svg>
          </div>
          <h3 class="text-xl font-bold font-display text-neutral-stone">Vibe Coding Workshop Series</h3>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          <a href="https://cuny-ai-lab.github.io/gen-dev-foundations/" target="_blank" rel="noopener noreferrer" class="group block bg-white rounded-xl border border-transparent hover:border-vibrant-300 hover:shadow-lg transition-all p-6">
            <div class="flex items-start justify-between gap-3 mb-3">
              <span class="inline-flex items-center px-2.5 py-0.5 bg-vibrant-50 text-vibrant-700 text-xs font-medium rounded-full">Part 1</span>
              <svg class="w-4 h-4 text-gray-400 group-hover:text-vibrant-600 transition-colors flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </div>
            <h4 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-vibrant-600 transition-colors">Foundations: AI, Command Line, and Version Control</h4>
            <p class="text-gray-600 text-sm leading-relaxed">Core concepts for AI-assisted development, including environment setup, terminal basics, and Git workflows.</p>
          </a>
          <a href="https://cuny-ai-lab.github.io/vibe-coding-prototypes" target="_blank" rel="noopener noreferrer" class="group block bg-white rounded-xl border border-transparent hover:border-vibrant-300 hover:shadow-lg transition-all p-6">
            <div class="flex items-start justify-between gap-3 mb-3">
              <span class="inline-flex items-center px-2.5 py-0.5 bg-vibrant-50 text-vibrant-700 text-xs font-medium rounded-full">Part 2</span>
              <svg class="w-4 h-4 text-gray-400 group-hover:text-vibrant-600 transition-colors flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </div>
            <h4 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-vibrant-600 transition-colors">Vibe-Coding Prototypes</h4>
            <p class="text-gray-600 text-sm leading-relaxed">Building prototypes with AI coding assistants, including prompting strategies, project design, and troubleshooting.</p>
          </a>
        </div>
      </div>

      <!-- Sandbox Workshops -->
      <div class="mb-12">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-amber-600" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342" />
            </svg>
          </div>
          <h3 class="text-xl font-bold font-display text-neutral-stone">Sandbox Workshops</h3>
        </div>

        <!-- Workspace Foundations series -->
        <div class="mb-8">
          <div class="flex items-center gap-2 mb-4">
            <h4 class="text-base font-bold font-display text-neutral-stone">Workspace Foundations Series</h4>
          </div>
          <div class="grid md:grid-cols-3 gap-6">
            <a href="https://cuny-ai-lab.github.io/system-prompting/" target="_blank" rel="noopener noreferrer" class="group block bg-white rounded-xl border border-transparent hover:border-amber-300 hover:shadow-lg transition-all p-6">
              <div class="flex items-start justify-between gap-3 mb-3">
                <span class="inline-flex items-center px-2.5 py-0.5 bg-amber-50 text-amber-700 text-xs font-medium rounded-full">Part 1</span>
                <svg class="w-4 h-4 text-gray-400 group-hover:text-amber-600 transition-colors flex-shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              </div>
              <h5 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-amber-600 transition-colors">System Prompting</h5>
              <p class="text-gray-600 text-sm leading-relaxed">How to craft effective system prompts to shape AI behavior for classroom use cases and custom assistants.</p>
            </a>
            <a href="https://cuny-ai-lab.github.io/knowledge-collections/" target="_blank" rel="noopener noreferrer" class="group block bg-white rounded-xl border border-transparent hover:border-amber-300 hover:shadow-lg transition-all p-6">
              <div class="flex items-start justify-between gap-3 mb-3">
                <span class="inline-flex items-center px-2.5 py-0.5 bg-amber-50 text-amber-700 text-xs font-medium rounded-full">Part 2</span>
                <svg class="w-4 h-4 text-gray-400 group-hover:text-amber-600 transition-colors flex-shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              </div>
              <h5 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-amber-600 transition-colors">Knowledge Collections</h5>
              <p class="text-gray-600 text-sm leading-relaxed">Building and managing knowledge collections to ground AI responses in course materials and curated sources.</p>
            </a>
            <a href="https://cuny-ai-lab.github.io/skills-tools/#1" target="_blank" rel="noopener noreferrer" class="group block bg-white rounded-xl border border-transparent hover:border-amber-300 hover:shadow-lg transition-all p-6">
              <div class="flex items-start justify-between gap-3 mb-3">
                <span class="inline-flex items-center px-2.5 py-0.5 bg-amber-50 text-amber-700 text-xs font-medium rounded-full">Part 3</span>
                <svg class="w-4 h-4 text-gray-400 group-hover:text-amber-600 transition-colors flex-shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              </div>
              <h5 class="text-lg font-bold text-neutral-stone mb-2 group-hover:text-amber-600 transition-colors">Skills and Tools</h5>
              <p class="text-gray-600 text-sm leading-relaxed">Customizing agentic tools and skills to extend AI assistant capabilities for specialized classroom workflows.</p>
            </a>
          </div>
        </div>

        <!-- Standalone decks -->
        <div class="pt-8 border-t border-gray-200">
          <h4 class="text-base font-bold font-display text-neutral-stone mb-4">Individual Workshops</h4>
          <div class="grid md:grid-cols-2 gap-6">
            <a href="https://cuny-ai-lab.github.io/creative-coding" target="_blank" rel="noopener noreferrer" class="group block bg-white rounded-xl border border-transparent hover:border-amber-300 hover:shadow-lg transition-all p-6">
              <div class="flex items-start justify-between gap-3 mb-3">
                <h5 class="text-lg font-bold text-neutral-stone group-hover:text-amber-600 transition-colors">Creative Coding</h5>
                <svg class="w-4 h-4 text-gray-400 group-hover:text-amber-600 transition-colors flex-shrink-0 mt-1" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">An introduction to creative coding with AI, exploring generative art and creative applications of programming.</p>
            </a>
            <a href="https://cuny-ai-lab.github.io/critical-play/" target="_blank" rel="noopener noreferrer" class="group block bg-white rounded-xl border border-transparent hover:border-amber-300 hover:shadow-lg transition-all p-6">
              <div class="flex items-start justify-between gap-3 mb-3">
                <h5 class="text-lg font-bold text-neutral-stone group-hover:text-amber-600 transition-colors">Critical Play</h5>
                <svg class="w-4 h-4 text-gray-400 group-hover:text-amber-600 transition-colors flex-shrink-0 mt-1" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">A workshop on critical approaches to AI through play, experimentation, and hands-on exploration.</p>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
